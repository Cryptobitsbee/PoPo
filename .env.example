# Copy this file to apps/desktop/.env.local for a contributor build.
#
# Firebase web config and a Desktop OAuth client ID are public identifiers,
# not authorization secrets. Security comes from Firebase Auth, Security
# Rules, API restrictions, and quotas. Contributors/forks should use their
# own development Firebase/GCP projects rather than PoPo production.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use (default) for a normal contributor Firebase project. PoPo's official
# production project currently uses the named database "popo-flow".
VITE_FIRESTORE_DATABASE_ID=(default)

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Desktop app. PoPo's existing Google client registration requires both values
# during token exchange. The `client secret` cannot remain confidential in a
# distributed desktop app and MUST NOT be treated as an authorization boundary;
# PKCE + OAuth state provide the per-attempt protections.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Do NOT put any confidential credential in VITE_* variables or the repository:
# - GCP service-account JSON/private keys
# - Gemini/Google AI Studio API keys
# - Authenticode/PFX signing certificates or passwords
#
# The GCP service-account JSON is selected in Settings → GCP Setup. PoPo
# stores only its original source path plus project/language metadata in
# %APPDATA%\ai.popo.desktop\gcp.json; the key file itself is never copied.
