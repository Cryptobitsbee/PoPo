# Firebase (client — used only by the main window React side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GCP project (used for logging / display in GCP Setup wizard)
VITE_GCP_PROJECT_ID=

# NOTE: the GCP service-account JSON path is NOT read from env.
# It is configured per-user via Settings → GCP Setup and stored at
# %APPDATA%\popo\gcp-sa.json. See docs/TECHNICAL_SPEC.md §5.
