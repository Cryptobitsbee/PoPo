{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/copy-geist-fonts.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/copy-geist-fonts.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:store": "tauri build --bundles nsis --config src-tauri/tauri.store.conf.json",
    "tauri:build:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-msix.ps1",
    "tauri:build:msix:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-msix.ps1 -LocalUnsigned",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@popo/shared-types": "workspace:*",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "firebase": "^10.14.0",
    "framer-motion": "^11.11.0",
    "geist": "1.7.2",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.4",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0-beta.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
