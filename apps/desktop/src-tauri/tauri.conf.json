{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "popo",
  "version": "0.1.0",
  "identifier": "ai.popo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "popo",
        "decorations": false,
        "transparent": false,
        "width": 1080,
        "height": 680,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0D0D"
      },
      {
        "label": "pill",
        "url": "/pill",
        "width": 300,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focusable": false,
        "visible": true,
        "center": false
      },
      {
        "label": "switcher",
        "url": "/switcher",
        "title": "popo mode switcher",
        "width": 480,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focusable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "headerImage": "assets/installer/header.bmp",
        "sidebarImage": "assets/installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "assets/installer/hooks.nsh",
        "compression": "lzma",
        "installMode": "currentUser",
        "startMenuFolder": "popo",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "assets/installer/English.nsh"
        }
      }
    }
  }
}
