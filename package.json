{
  "name": "popo",
  "private": true,
  "version": "0.1.0",
  "description": "PoPo — Windows system-level AI voice dictation",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "dev:landing": "pnpm --filter landing dev",
    "build": "pnpm --filter desktop tauri build",
    "build:landing": "pnpm --filter landing build",
    "tauri": "pnpm --filter desktop tauri",
    "typecheck": "pnpm -r --parallel typecheck",
    "security:audit:npm": "node scripts/audit-osv.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "sharp": "0.35.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.5.0",
      "postcss": "8.5.18",
      "protobufjs": "8.6.6",
      "websocket-driver": "0.7.5",
      "@grpc/grpc-js": "1.9.16"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "next"
      ]
    }
  },
  "author": "PoPo contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cryptobitsbee/PoPo.git"
  }
}
