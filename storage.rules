rules_version = '2';

// PoPo — Firebase Storage security rules
//
// Audio layout is flat and deterministic:
//   audio/{uid}/{sessionId}.wav
//
// Authenticated owners may list/read/delete their own recordings. Uploads
// must be WAV files no larger than 10 MiB (roughly five minutes of PoPo's
// 16 kHz mono PCM16 format). Everything else is denied.

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /audio/{userId}/{fileName=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && fileName.matches('^[A-Za-z0-9_-]{1,128}\\.wav$')
                            && request.resource.size > 0
                            && request.resource.size <= 10 * 1024 * 1024
                            && request.resource.contentType == 'audio/wav';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
